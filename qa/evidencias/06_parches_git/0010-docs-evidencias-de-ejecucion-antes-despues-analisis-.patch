diff --git a/qa/evidencias/06_parches_git/0002-fix-api-bloqueo-temporal-tras-5-intentos-fallidos-en.patch b/qa/evidencias/06_parches_git/0002-fix-api-bloqueo-temporal-tras-5-intentos-fallidos-en.patch
