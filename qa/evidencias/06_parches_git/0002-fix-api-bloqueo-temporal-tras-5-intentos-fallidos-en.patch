From 2f30f23a85edb36034719cfe12f787b30e5446f3 Mon Sep 17 00:00:00 2001
From: Equipo QA <qa@example.com>
Date: Thu, 22 Oct 2026 00:51:07 +0000
Subject: [PATCH 02/10] fix(api): bloqueo temporal tras 5 intentos fallidos en
 /api/tokens, responde 429 (BUG-08)

---
 app/api/auth.py | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/app/api/auth.py b/app/api/auth.py
index 82ab263..4a89970 100644
--- a/app/api/auth.py
+++ b/app/api/auth.py
@@ -1,4 +1,6 @@
+import time
 import sqlalchemy as sa
+from flask import g, request, current_app
 from flask_httpauth import HTTPBasicAuth, HTTPTokenAuth
 from app import db
 from app.models import User
@@ -8,15 +10,34 @@ basic_auth = HTTPBasicAuth()
 token_auth = HTTPTokenAuth()
 
 
+MAX_FAILED_ATTEMPTS = 5
+LOCK_WINDOW_SECONDS = 60
+
+
+def _attempts(key):
+    store = current_app.__dict__.setdefault('_login_failures', {})
+    now = time.time()
+    store[key] = [t for t in store.get(key, []) if now - t < LOCK_WINDOW_SECONDS]
+    return store[key]
+
+
 @basic_auth.verify_password
 def verify_password(username, password):
+    key = (request.remote_addr, username)
+    if len(_attempts(key)) >= MAX_FAILED_ATTEMPTS:
+        g.rate_limited = True
+        return None
     user = db.session.scalar(sa.select(User).where(User.username == username))
     if user and user.check_password(password):
+        _attempts(key).clear()
         return user
+    _attempts(key).append(time.time())
 
 
 @basic_auth.error_handler
 def basic_auth_error(status):
+    if g.get('rate_limited'):
+        return error_response(429, 'too many failed attempts, try again later')
     return error_response(status)
 
 
