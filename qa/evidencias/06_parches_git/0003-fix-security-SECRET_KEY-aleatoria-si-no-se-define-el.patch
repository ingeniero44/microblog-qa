From 4e68c34ced2bccd606affd9ac1c56d2561e2abb9 Mon Sep 17 00:00:00 2001
From: Equipo QA <qa@example.com>
Date: Thu, 22 Oct 2026 00:51:07 +0000
Subject: [PATCH 03/10] fix(security): SECRET_KEY aleatoria si no se define;
 elimina clave publica por defecto (BUG-05,06)

---
 config.py | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/config.py b/config.py
index 7e50c9e..3496e07 100644
--- a/config.py
+++ b/config.py
@@ -1,4 +1,5 @@
 import os
+import secrets
 from dotenv import load_dotenv
 
 basedir = os.path.abspath(os.path.dirname(__file__))
@@ -6,7 +7,9 @@ load_dotenv(os.path.join(basedir, '.env'))
 
 
 class Config:
-    SECRET_KEY = os.environ.get('SECRET_KEY') or 'you-will-never-guess'
+    # Si no se define SECRET_KEY en el entorno se genera una aleatoria (no hay clave publica por defecto).
+    # En produccion con varios procesos DEBE definirse SECRET_KEY como variable de entorno.
+    SECRET_KEY = os.environ.get('SECRET_KEY') or secrets.token_hex(32)
     SERVER_NAME = os.environ.get('SERVER_NAME')
     SQLALCHEMY_DATABASE_URI = os.environ.get('DATABASE_URL', '').replace(
         'postgres://', 'postgresql://') or \
