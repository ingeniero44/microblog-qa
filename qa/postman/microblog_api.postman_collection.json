    {
      "name": "PM-11 Fuerza bruta: bloqueo 429",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base}}/api/tokens",
          "host": [
            "{{base}}"
          ],
          "path": [
            "api",
            "tokens"
          ]
        },
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "postman1"
            },
            {
              "key": "password",
              "value": "mala"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"401 o 429\", () => pm.expect([401,429]).to.include(pm.response.code));"
            ]
          }
        }
      ]
